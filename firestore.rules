rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function isOwner(familyId) {
      return signedIn() &&
        get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      // Davet kodunu bilen giriş yapmış kullanıcı sadece o tek belgeyi okuyabilir.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerUid == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /families/{familyId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow read: if isMember(familyId);
      allow update: if isOwner(familyId);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(familyId);

        // Aile sahibi kendi üyelik kaydını oluşturabilir.
        // Davetle gelen kullanıcı ise kendi uid'si için, geçerli kodu kanıtlayarak katılabilir.
        allow create: if signedIn() && request.auth.uid == uid && (
          get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid
          ||
          (
            request.resource.data.inviteCode is string
            && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.familyId == familyId
            && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.active == true
          )
        );

        allow update: if signedIn() && (
          request.auth.uid == uid || isOwner(familyId)
        );

        allow delete: if signedIn() && (
          request.auth.uid == uid || isOwner(familyId)
        );
      }

      match /state/{docId} {
        allow read, write: if isMember(familyId);
      }

      match /activity/{activityId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId)
          && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
